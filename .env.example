# Set these in the server process environment. This file is not loaded automatically.
ADMIN_PASSWORD=
WORKER_PASSWORD=
COOKIE_SECURE=1
PORT=8000
DATA_DIR=./data
KOREAN_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc
# Optional real vision recommendations (server only)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=100
AI_MIN_INTERVAL_SECONDS=1
# Future Supabase migration; not used by this SQLite MVP
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
