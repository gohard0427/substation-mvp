# Set these in the server process environment. This file is not loaded automatically.
ADMIN_PASSWORD=
WORKER_PASSWORD=
COOKIE_SECURE=1
PORT=8000
DATA_DIR=./data
KOREAN_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc
# Optional real vision recommendations (server only)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=100
AI_MIN_INTERVAL_SECONDS=1
# Future Supabase migration; not used by this SQLite MVP
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Production ASGI backend only (secret, never a VITE/public value)
DEPLOYMENT_MODE=1
EDGE_PROXY_SECRET=
MAX_UPLOAD_BYTES=94371840
LOGIN_MAX_ATTEMPTS=10
# Cloudflare Pages Functions settings only; separate from backend runtime
BACKEND_URL=
PUBLIC_ORIGIN=
