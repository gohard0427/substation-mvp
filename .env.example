# Server-only external vision API key:
OPENAI_API_KEY=
# Optional free-API vision recommendations; OFF until cost/provider approval.
AI_ENABLED=false
OPENAI_VISION_MODEL=gpt-5.4-mini-2026-03-17
AI_DAILY_LIMIT=20

# Whole-app lifetime trial attempts (1-100), failed attempts also count.
AI_TOTAL_LIMIT=100
