{
  "name": "substation-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "무료 Cloudflare Pages + Supabase 작업 사진 명판 MVP",
  "scripts": {
    "start": "python server.py",
    "test": "python -m unittest discover -s tests -v && node tests/test_frontend.cjs && node tests/test_proxy.mjs",
    "test:frontend": "node tests/test_frontend.cjs",
    "check": "node --check static/app.js",
    "build": "node scripts/build.mjs",
    "test:edge": "node tests/test_proxy.mjs",
    "test:free": "node tests/test_free_api.mjs",
    "test:browser": "npm run build && node tests/test_free_browser.mjs",
    "test:ai": "node tests/test_ai.mjs",
    "test:maintenance": "node tests/test_maintenance.mjs",
    "test:zip": "node tests/test_zip_safety.mjs",
    "test:e2e": "npm run build && node tests/test_e2e.mjs",
    "test:audit": "npm run test:free && npm run test:ai && npm run test:maintenance && npm run test:zip && npm test && npm run test:browser && node tests/test_e2e.mjs && npm run test:learning && npm run test:station",
    "test:reference-import": "node tests/test_reference_import.mjs",
    "test:learning": "node tests/test_learning.mjs",
    "test:station": "node tests/test_station_name.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "5.3.1",
    "@zip.js/zip.js": "2.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1"
  }
}
